[ext_resource type="Script" uid="uid://bcg63bvxqumsx" path="res://resources/quest.gd" id="4_wkqev"]

[resource]
script = ExtResource("4_wkqev")
name = "Welcome Home!"
blurb = "Hello!

I am Willow from the village council. We were sad to hear about your great grandmother, but happy to hear a family member was moving into her home!

She had quite the green thumb, and used to fill produce orders for lots of folks here. Don't be surprised if you get requests for produce, too.

As a welcome gift from everyone in the village, please accept this hoe, and some lettuce seeds, so you can get started making your home.

Cheers!"
note = "Not really a quest; this is more the \"welcome to the game\" than anything.

Possible character names:

Spike
Willow
Fern
Acorn
Moss
Thistle
Bramble
Pip

"
metadata/_custom_type_script = "uid://bcg63bvxqumsx"
